{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grow3.jp/schemas/practice-lens/v0.1/card.schema.json",
  "title": "Practice Lens Library",
  "description": "業種横断の「判断の分かれ目（観点）」カード。organization-diagnosis の common.schema.json の部品を $ref で借り、封筒だけ別に持つ（case横断のため case_id を持たない）。候補（library/candidates/lens_candidates.json）と正式Library（library/lens_library.json）の両方がこの schema に従う。公開前提：顧客Evidenceへの参照も機密度も持たない（それらは非公開の promotion record 側）。$ref は $id で解決する（実ファイルを v0.1/ フォルダに置く必要はない）。",
  "type": "object",
  "required": [
    "schema_version",
    "library_type",
    "last_updated_at",
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "library_type": {
      "const": "practice_lens"
    },
    "last_updated_at": {
      "$ref": "../../organization-diagnosis/v0.1/common.schema.json#/$defs/dateTime"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/card"
      }
    },
    "extensions": {
      "$ref": "../../organization-diagnosis/v0.1/common.schema.json#/$defs/extensions"
    }
  },
  "$defs": {
    "cardId": {
      "type": "string",
      "pattern": "^LENS-[0-9]{3,}$",
      "description": "候補の間は内容の改訂を許す（ただし外部の記録から参照されているIDの意味は変えない）。正式Libraryに採用した後は不変。意味が変わる改訂・棄却では新IDを発行する。"
    },
    "businessModelTag": {
      "type": "string",
      "enum": [
        "project_based",
        "repetitive_production",
        "store_retail",
        "human_service",
        "professional_service"
      ]
    },
    "valueChainStage": {
      "type": "string",
      "enum": [
        "intake",
        "survey",
        "design",
        "production",
        "handoff",
        "install",
        "close",
        "after",
        "support"
      ],
      "description": "業種によらない共通語彙。業種固有の工程名は examples 側に書く。"
    },
    "reviewStatus": {
      "type": "string",
      "enum": [
        "unreviewed",
        "spot_checked",
        "verified",
        "rejected"
      ],
      "description": "organization-diagnosis の各item schemaと同じ4値だが、意味はLens側で別定義する。unreviewed＝現場での有効性は未確認（cases_count 0）。rubric合格（Critic通過）や、実案件から生まれたことだけでは変わらない。spot_checked＝1案件以上で問いとして使い、有効性を確認した。verified には未認定。verified＝異なる2案件以上で有効性を確認し、人が認定した。card の if/then で cases_count>=2 を強制する（件数が足りても自動では上がらない）。rejected＝Lensとして不採用。ある案件で効かなかっただけでは rejected にしない。"
    },
    "industryExample": {
      "type": "object",
      "required": [
        "industry",
        "scene"
      ],
      "additionalProperties": false,
      "properties": {
        "industry": {
          "type": "string",
          "description": "signage / electrical / retail / care など"
        },
        "scene": {
          "type": "string",
          "description": "一つの具体的な場面を一文で（rubric 5）"
        }
      }
    },
    "card": {
      "type": "object",
      "required": [
        "card_id",
        "title",
        "business_model_tags",
        "value_chain_stages",
        "observation",
        "why_it_matters",
        "examples",
        "prompt",
        "sources",
        "field_validation",
        "review_status",
        "created_at",
        "updated_at"
      ],
      "additionalProperties": false,
      "if": {
        "properties": {
          "review_status": {
            "const": "verified"
          }
        },
        "required": [
          "review_status"
        ]
      },
      "then": {
        "properties": {
          "field_validation": {
            "properties": {
              "cases_count": {
                "minimum": 2
              }
            }
          }
        }
      },
      "properties": {
        "card_id": {
          "$ref": "#/$defs/cardId"
        },
        "title": {
          "type": "string",
          "maxLength": 60,
          "description": "判断の動詞で終える（rubric 3）"
        },
        "business_model_tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/businessModelTag"
          }
        },
        "value_chain_stages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/valueChainStage"
          }
        },
        "boundary_context": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "from",
            "to"
          ],
          "properties": {
            "from": {
              "$ref": "#/$defs/businessModelTag"
            },
            "to": {
              "$ref": "#/$defs/businessModelTag"
            }
          },
          "description": "この観点が特に効く型の境目（例 repetitive_production → project_based）。カードの属性ではなく適用コンテキストなので任意。"
        },
        "observation": {
          "type": "string",
          "description": "一つの判断だけ。抽象語で終わらない（rubric 1,2）"
        },
        "why_it_matters": {
          "type": "string",
          "description": "顧客価値・品質・安全・効率・継承のどれにつながるか一文で（rubric 10）"
        },
        "examples": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/industryExample"
          },
          "description": "異業種で最低2つ（rubric 6）"
        },
        "prompt": {
          "type": "string",
          "maxLength": 80,
          "description": "30秒で話し始められ、例なしで成立し、選択式にならない（rubric 7,8,9）"
        },
        "anti_pattern": {
          "type": [
            "string",
            "null"
          ]
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "description": "framework/sources.md 上の資料名。URLではなく台帳名で書く"
          }
        },
        "field_validation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cases_count"
          ],
          "properties": {
            "cases_count": {
              "type": "integer",
              "minimum": 0
            }
          },
          "description": "実案件での確認状況の要約だけ。cases_count は、このLensを問いとして実際に使い、有効性を確認した異なる案件の数。Lensが生まれた案件は数えない。同一案件で何度使っても1件。使ったが効かなかった案件は数えない。裏づけは非公開の promotion record（record_kind=field_use）にあり、tools/cases_count_check.py で照合する。"
        },
        "review_status": {
          "$ref": "#/$defs/reviewStatus"
        },
        "created_at": {
          "$ref": "../../organization-diagnosis/v0.1/common.schema.json#/$defs/dateTime"
        },
        "updated_at": {
          "$ref": "../../organization-diagnosis/v0.1/common.schema.json#/$defs/dateTime"
        },
        "extensions": {
          "$ref": "../../organization-diagnosis/v0.1/common.schema.json#/$defs/extensions"
        }
      }
    }
  }
}
